{
  "info": {
    "name": "Noom Sleep API",
    "description": "Collection for the sleep logger take-home API. Set the `baseUrl` and `userId` collection variables. The `userId` defaults to the Flyway-seeded demo user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "1. Create sleep log (last night)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/sleep-logs", "host": ["{{baseUrl}}"], "path": ["api", "sleep-logs"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bedTime\": \"2024-03-14T23:15:00\",\n  \"wakeTime\": \"2024-03-15T07:00:00\",\n  \"feeling\": \"GOOD\"\n}"
        },
        "description": "Requirement #1 — logs last night's sleep. The server stamps the sleep date with today's date; the body carries the time-in-bed interval and the morning feeling (BAD|OK|GOOD). Returns 201, or 409 if a log already exists for today."
      }
    },
    {
      "name": "2. Fetch last night's sleep",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-User-Id", "value": "{{userId}}" } ],
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs/last-night",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs", "last-night"]
        },
        "description": "Requirement #2 — the user's most recent sleep log. 404 if none."
      }
    },
    {
      "name": "3. 30-day averages",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-User-Id", "value": "{{userId}}" } ],
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs/averages?days=30",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs", "averages"],
          "query": [ { "key": "days", "value": "30" } ]
        },
        "description": "Requirement #3 — range, average time in bed, average bed/wake clock times, and morning-feeling frequencies. `days` is optional (defaults to 30)."
      }
    },
    {
      "name": "Error — missing X-User-Id (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs/last-night",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs", "last-night"]
        }
      }
    },
    {
      "name": "Error — invalid feeling (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/sleep-logs", "host": ["{{baseUrl}}"], "path": ["api", "sleep-logs"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bedTime\": \"2024-03-14T23:00:00\",\n  \"wakeTime\": \"2024-03-15T07:00:00\",\n  \"feeling\": \"AMAZING\"\n}"
        }
      }
    }
  ]
}
